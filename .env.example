# Optional developer fallback. Most users connect providers in the harness I/O panel.
MODEL_PROVIDER=openrouter

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-6-luna

WORKSPACE_ROOT=generated_agents

MAX_REPAIR_ATTEMPTS=2
MODEL_CHAT_TIMEOUT_SECONDS=60
MODEL_BUILD_TIMEOUT_SECONDS=150

# Build ceiling in USD. Decimal, without a currency symbol.
BUILD_BUDGET_USD=1.00
# The catalogue calculates the reservation; this optional override can only increase it.
# MODEL_CALL_RESERVATION_USD=...

MODEL_REGISTRY_PATH=config/model_registry.json
MCP_REGISTRY_PATH=config/mcp_registry.json
# Only paid, named catalogue entries are permitted. Free endpoints and routers are rejected by the backend.
ALLOW_MODEL_ROUTER=false

# Comma-separated host names accepted by the web server. Add your public domain
# before deployment, for example: research.example.com,localhost,127.0.0.1
ALLOWED_HOSTS=127.0.0.1,localhost,testserver
